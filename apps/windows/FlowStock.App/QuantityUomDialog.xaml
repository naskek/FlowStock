<Window x:Class="FlowStock.App.QuantityUomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Количество"
        Height="390" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Количество" />
            <TextBox x:Name="QtyBox" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Единица" />
            <ComboBox x:Name="UomCombo" Margin="0,6,0,0" DisplayMemberPath="Name" />
        </StackPanel>
        <TextBlock x:Name="TotalText" Grid.Row="2" Margin="0,10,0,0" Foreground="Gray" />
        <Border x:Name="CommercialTermsPanel"
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Коммерческие условия" FontWeight="SemiBold" />
                <TextBlock x:Name="PricePreviewText" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="VatPreviewText" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="CommercialIssueText"
                           Margin="0,3,0,0"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <CheckBox x:Name="ManualPriceOverrideCheck"
                          Margin="0,8,0,0"
                          Content="Задать цену вручную"
                          Checked="ManualPriceOverrideCheck_Changed"
                          Unchecked="ManualPriceOverrideCheck_Changed" />
                <TextBox x:Name="UnitPriceGrossBox"
                         Margin="0,6,0,0"
                         IsEnabled="False" />
                <TextBlock x:Name="CommercialLockText"
                           Margin="0,6,0,0"
                           Foreground="#8A5A00"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="80" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>

