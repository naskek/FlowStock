<Window x:Class="FlowStock.App.CustomPalletCapacityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нестандартная палетизация"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ProgressText"
                   Grid.Row="0"
                   Foreground="Gray"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Товар" Foreground="Gray" />
            <TextBlock x:Name="ItemNameText"
                       Margin="0,2,0,12"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Максимум на палету (баз. ед.)" />
            <TextBox x:Name="CapacityTextBox"
                     Width="180"
                     Margin="0,4,0,0"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="Значение действует только для текущего планирования и не изменяет карточку товара." />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Width="100"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Применить"
                    Width="110"
                    IsDefault="True"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
