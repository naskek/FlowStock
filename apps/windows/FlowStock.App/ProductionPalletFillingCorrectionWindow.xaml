<Window x:Class="FlowStock.App.ProductionPalletFillingCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корректировка наполнения HU"
        Width="860"
        Height="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="HU" VerticalAlignment="Center" />
            <TextBox x:Name="HuTextBox" Width="300" Margin="8,0,8,0" />
            <Button Content="Preview" Padding="14,4" Click="Preview_Click" />
            <Button Content="История" Padding="14,4" Margin="8,0,0,0" Click="History_Click" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,8" Padding="10" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ActionText" FontWeight="SemiBold" FontSize="15" />
                <TextBlock x:Name="SourceText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="MarkingText" Margin="0,4,0,0" />
                <TextBlock x:Name="LedgerText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="BlockersText" Margin="0,6,0,0" Foreground="#B42318" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Компоненты" Margin="0,0,6,0">
                <DataGrid x:Name="ComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="План" Binding="{Binding PlannedQty}" Width="80" />
                        <DataGridTextColumn Header="Наполнено" Binding="{Binding FilledQty}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Цепочка корректировок" Margin="6,0,0,0">
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="HistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding AdjustmentId}" Width="45" />
                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="110" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="130" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding ReasonText}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Причина" VerticalAlignment="Top" Margin="0,5,8,0" />
            <TextBox x:Name="ReasonTextBox"
                     Grid.Column="1"
                     MinHeight="58"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="OpenSourceButton" Content="Source PRD" IsEnabled="False" Click="OpenSource_Click" />
                <Button x:Name="OpenCorButton" Content="COR" IsEnabled="False" Margin="8,0,0,0" Click="OpenCor_Click" />
                <Button x:Name="OpenReplacementButton" Content="Replacement PRD" IsEnabled="False" Margin="8,0,0,0" Click="OpenReplacement_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton" Content="Подтвердить" IsEnabled="False" Padding="16,5" Click="Confirm_Click" />
                <Button Content="Закрыть" Margin="8,0,0,0" Padding="16,5" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
