<Window x:Class="FlowStock.App.TsdDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётные записи"
        Height="550" Width="900" MinHeight="340" MinWidth="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Учётные записи ПК Web и ТСД"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="CreateAccountButton" Content="Создать аккаунт"
                    Width="150" Margin="0,0,8,4" Click="Create_Click" />
            <Button x:Name="EditAccountButton" Content="Редактировать"
                    Width="140" Margin="0,0,8,4" Click="Edit_Click" IsEnabled="False" />
            <Button x:Name="ChangePasswordButton" Content="Сменить пароль"
                    Width="145" Margin="0,0,8,4" Click="ChangePassword_Click" IsEnabled="False" />
            <Button x:Name="RefreshAccountsButton" Content="Обновить"
                    Width="105" Margin="0,0,8,4" Click="Refresh_Click" />
        </WrapPanel>
        <DataGrid x:Name="DevicesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="DevicesGrid_SelectionChanged"
                  MouseDoubleClick="DevicesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="2*" />
                <DataGridTextColumn Header="Платформа" Binding="{Binding PlatformDisplay}" Width="*" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="95" />
                <DataGridTextColumn Header="Роль ПК Web" Binding="{Binding AccessRole}" Width="*" />
                <DataGridTextColumn Header="ID устройства" Binding="{Binding DeviceId}" Width="1.6*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="AccountsStatusText" Grid.Row="3" Margin="0,8,0,0"
                   Foreground="Gray" Text="Выберите запись для редактирования или смены пароля." />
    </Grid>
</Window>
