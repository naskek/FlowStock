<Window x:Class="FlowStock.App.TsdDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учётные записи"
        Height="550" Width="900" MinHeight="340" MinWidth="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Учётные записи ПК Web и ТСД"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="CreateAccountButton" Content="Создать аккаунт"
                    Width="150" Margin="0,0,8,4" Click="Create_Click" />
            <Button x:Name="EditAccountButton" Content="Редактировать"
                    Width="140" Margin="0,0,8,4" Click="Edit_Click" IsEnabled="False" />
        </WrapPanel>
        <DataGrid x:Name="DevicesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="DevicesGrid_SelectionChanged"
                  MouseDoubleClick="DevicesGrid_MouseDoubleClick"
                  KeyDown="DevicesGrid_KeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"
                                    IsReadOnly="True" Width="2*" />
                <DataGridTemplateColumn Header="Платформа" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding Platform, Mode=OneWay}"
                                      SelectionChanged="InlinePlatform_SelectionChanged">
                                <ComboBoxItem Content="ТСД" Tag="TSD" />
                                <ComboBoxItem Content="ПК" Tag="PC" />
                                <ComboBoxItem Content="ПК + ТСД" Tag="BOTH" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Активен" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Click="InlineActive_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Роль ПК Web" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding AccessRole, Mode=OneWay}"
                                      SelectionChanged="InlineRole_SelectionChanged">
                                <ComboBoxItem Content="OPERATOR" Tag="OPERATOR" />
                                <ComboBoxItem Content="ADMIN" Tag="ADMIN" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID устройства" Binding="{Binding DeviceId}"
                                    IsReadOnly="True" Width="1.6*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="AccountsStatusText" Grid.Row="3" Margin="0,8,0,0"
                   Foreground="Gray" Text="Выберите запись для редактирования. F5 — перечитать список." />
    </Grid>
</Window>
