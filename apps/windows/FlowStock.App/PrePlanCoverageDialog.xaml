<Window x:Class="FlowStock.App.PrePlanCoverageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Покрытие заказа"
        Height="620" Width="980"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="WarningTextBox"
                 Grid.Row="0"
                 MaxHeight="130"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <Grid x:Name="UnifiedCoverageGrid"
                   Grid.Row="1"
                   Margin="0,12,0,0"
                   Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Складские HU" Grid.Column="0" Margin="0,0,8,0">
                <DataGrid x:Name="WarehouseHuGrid"
                          ItemsSource="{Binding WarehouseRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="HU" Binding="{Binding HuCode}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" IsReadOnly="True" Width="1.2*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyDisplay}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding DisabledReason}" IsReadOnly="True" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Header="Планируемый выпуск из INTERNAL" Grid.Column="1" Margin="8,0,0,0">
                <DataGrid x:Name="InternalHuGrid"
                          ItemsSource="{Binding InternalRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="HU" Binding="{Binding HuCode}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" IsReadOnly="True" Width="1.2*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyDisplay}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceRef}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" IsReadOnly="True" Width="90" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding DisabledReason}" IsReadOnly="True" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
        <TextBlock x:Name="QuestionTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Vertical">
            <Button x:Name="ApplySelectedButton"
                    Content="Применить и допланировать"
                    Width="260"
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    Visibility="Collapsed"
                    Click="ApplySelected_Click" />
            <Button x:Name="PlanAllButton"
                    Content="План без переноса"
                    Width="260"
                    Margin="0,0,0,8"
                    Click="PlanAll_Click" />
            <Button x:Name="PlanSafeOnlyButton"
                    Content="Только безопасные"
                    Width="260"
                    Margin="0,0,0,8"
                    Visibility="Collapsed"
                    Click="PlanSafeOnly_Click" />
            <Button Content="Отмена"
                    Width="260"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
