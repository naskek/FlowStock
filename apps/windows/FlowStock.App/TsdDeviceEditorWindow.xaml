<Window x:Class="FlowStock.App.TsdDeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт" Width="470" SizeToContent="Height"
        MinHeight="240" MaxHeight="680" MinWidth="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="ModeHeader" FontWeight="SemiBold" FontSize="17" />
            <TextBlock x:Name="AccountNameText" Margin="0,5,0,0" Foreground="Gray"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ProfileFieldsPanel">
                    <TextBlock Text="Логин" />
                    <TextBox x:Name="LoginBox" Margin="0,4,0,12" MaxLength="150" />
                    <TextBlock Text="Платформа" />
                    <ComboBox x:Name="PlatformBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="ТСД" Tag="TSD" />
                        <ComboBoxItem Content="ПК" Tag="PC" />
                        <ComboBoxItem Content="ПК + ТСД" Tag="BOTH" />
                    </ComboBox>
                    <TextBlock Text="Роль ПК Web" />
                    <ComboBox x:Name="AccessRoleBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="OPERATOR" Tag="OPERATOR" />
                        <ComboBoxItem Content="ADMIN" Tag="ADMIN" />
                    </ComboBox>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Роль действует только в ПК Web и не даёт административных прав WPF или ТСД." />
                    <CheckBox x:Name="IsActiveCheck" Content="Аккаунт активен" Margin="0,0,0,16" />
                </StackPanel>
                <StackPanel x:Name="PasswordFieldsPanel">
                    <TextBlock Text="Новый пароль" />
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12" />
                    <TextBlock Text="Подтверждение пароля" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="Firebrick"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,4" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Отмена" Width="100"
                    IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Сохранить" Width="130"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
