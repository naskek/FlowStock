<Window x:Class="FlowStock.App.CommercialPriceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прайс-листы" Width="1320" Height="720"
        MinWidth="920" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Режим" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ModeCombo" Width="165" SelectedIndex="0"
                              SelectionChanged="Filters_Changed">
                        <ComboBoxItem Content="Все назначения" Tag="all"/>
                        <ComboBoxItem Content="Прайс клиента" Tag="partner"/>
                        <ComboBoxItem Content="Цены товара" Tag="item"/>
                    </ComboBox>
                    <TextBlock Text="Клиент" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox x:Name="PartnerCombo" Width="230" DisplayMemberPath="DisplayName"
                              SelectionChanged="Filters_Changed"/>
                    <TextBlock Text="Товар" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox x:Name="ItemCombo" Width="290" DisplayMemberPath="Name"
                              SelectionChanged="Filters_Changed"/>
                    <Button Content="Сбросить выбор" Margin="8,0,0,0" Padding="10,4"
                            Click="Reset_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Поиск товара" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Width="195" TextChanged="Filters_Changed"/>
                    <TextBlock Text="GTIN" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="GtinBox" Width="160" TextChanged="Filters_Changed"/>
                    <TextBlock Text="Бренд" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="BrandBox" Width="170" TextChanged="Filters_Changed"/>
                    <TextBlock Text="Фасовка" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="VolumeBox" Width="155" TextChanged="Filters_Changed"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="ActiveItemsCheck" Content="Только активные товары" IsChecked="True"
                              VerticalAlignment="Center" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                    <CheckBox x:Name="InactiveOverridesCheck" Content="Включить неактивные цены клиентов"
                              Margin="22,0,0,0" VerticalAlignment="Center"
                              Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                    <CheckBox x:Name="UnpricedCheck" Content="Показать без цены (прайс клиента)"
                              Margin="22,0,0,0" VerticalAlignment="Center"
                              Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                    <Button x:Name="RefreshButton" Content="Сформировать" Padding="16,5"
                            Margin="24,0,0,0" Click="Refresh_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ReportGrid" Grid.Row="1" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding RowKindDisplay}" Width="95"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding PartnerName}" Width="220"/>
                <DataGridTextColumn Header="Код клиента" Binding="{Binding PartnerCode}" Width="120"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="260"/>
                <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" Width="155"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="140"/>
                <DataGridTextColumn Header="Фасовка" Binding="{Binding Volume}" Width="100"/>
                <DataGridTextColumn Header="Базовая с НДС" Binding="{Binding DefaultPriceGross, StringFormat={}{0:0.####}}" Width="115"/>
                <DataGridTextColumn Header="Цена клиента" Binding="{Binding PartnerPriceGross, StringFormat={}{0:0.####}}" Width="110"/>
                <DataGridTextColumn Header="Итоговая с НДС" Binding="{Binding EffectivePriceGross, StringFormat={}{0:0.####}}" Width="120"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding PriceSourceDisplay}" Width="110"/>
                <DataGridTextColumn Header="НДС %" Binding="{Binding VatRate, StringFormat={}{0:0.####}}" Width="85"/>
                <DataGridTextColumn Header="Товар активен" Binding="{Binding ItemIsActive}" Width="100"/>
                <DataGridTextColumn Header="Цена активна" Binding="{Binding PartnerPriceIsActive}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Выберите режим и сформируйте отчёт."
                       VerticalAlignment="Center" Foreground="#566174"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportExcelButton" Content="Экспорт Excel" MinWidth="115"
                        IsEnabled="False" Click="ExportExcel_Click"/>
                <Button x:Name="ExportPdfButton" Content="Экспорт PDF" MinWidth="115"
                        Margin="8,0,0,0" IsEnabled="False" Click="ExportPdf_Click"/>
                <Button Content="Закрыть" MinWidth="90" Margin="16,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
