<Window x:Class="FlowStock.App.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администрирование"
        Height="720" Width="940"
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="AdminCategoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Padding="10"
                Background="#F4F6F8"
                BorderBrush="#D8DDE3"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="2,2,2,12">
                    <TextBlock Text="Настройки"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Выберите категорию"
                               Margin="0,3,0,0"
                               Foreground="#666666" />
                </StackPanel>

                <ListBox x:Name="AdminCategoryList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource AdminCategoryItemStyle}"
                         SelectionChanged="AdminCategoryList_SelectionChanged">
                    <ListBoxItem Content="Система" Tag="system" />
                    <ListBoxItem Content="Обновление" Tag="update" />
                    <ListBoxItem Content="Веб-клиенты" Tag="clients" />
                    <ListBoxItem Content="Печать" Tag="printing" />
                    <ListBoxItem Content="Обслуживание" Tag="maintenance" />
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="2">
            <ScrollViewer x:Name="SystemCategoryPanel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Система"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Подключение к базе данных и административные учётные данные."
                               Margin="0,4,0,12"
                               Foreground="#666666"
                               TextWrapping="Wrap" />

                    <GroupBox Header="Системные настройки">
                        <StackPanel Margin="8">
                            <TextBlock Text="Настройка подключения к БД и управление аккаунтами для входа в веб-клиенты."
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Подключение к БД..."
                                        Width="180"
                                        Margin="0,0,8,8"
                                        Click="OpenDbConnection_Click" />
                                <Button Content="Создание аккаунта..."
                                        Width="180"
                                        Margin="0,0,8,8"
                                        Click="OpenTsdDevices_Click" />
                                <Button Content="Сменить пароль администратора..."
                                        Width="240"
                                        Margin="0,0,8,8"
                                        Click="ChangeAdminPassword_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdateCategoryPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Обновление"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Проверка production-сервера и запуск штатного обновления FlowStock."
                               Margin="0,4,0,12"
                               Foreground="#666666"
                               TextWrapping="Wrap" />

                    <GroupBox Header="Обновление FlowStock">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="InstalledBuildText" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateTargetText" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateDiagnosticsText" Margin="0,4,0,0" Foreground="#666666" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CheckUpdateButton"
                                        Content="Проверить"
                                        Width="130"
                                        Margin="0,0,8,8"
                                        Click="CheckUpdate_Click" />
                                <Button x:Name="InstallUpdateButton"
                                        Content="Обновить и перезапустить"
                                        Width="210"
                                        Margin="0,0,8,8"
                                        IsEnabled="False"
                                        Click="InstallUpdate_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ClientsCategoryPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Веб-клиенты"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Глобальный доступ к функциональным блокам ПК и ТСД веб-клиентов."
                               Margin="0,4,0,12"
                               Foreground="#666666"
                               TextWrapping="Wrap" />

                    <GroupBox Header="Доступ к веб-блокам">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ПК веб-клиент" FontWeight="SemiBold" />
                                <TextBlock Text="Отключенный блок скрывается у всех пользователей ПК."
                                           Margin="0,4,0,10"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="PcBlocksPanel" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ТСД веб-клиент" FontWeight="SemiBold" />
                                <TextBlock Text="Отключенные пункты не показываются на ТСД и не открываются по прямому маршруту."
                                           Margin="0,4,0,10"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Основные блоки" FontWeight="SemiBold" />
                                <StackPanel x:Name="TsdMainBlocksPanel" Margin="0,6,0,10" />
                                <TextBlock Text="Операции" FontWeight="SemiBold" />
                                <StackPanel x:Name="TsdOperationBlocksPanel" Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="ClientBlocksStatusText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Margin="0,12,0,10"
                                       TextWrapping="Wrap" />

                            <Button x:Name="SaveClientBlocksButton"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Content="Сохранить доступ к блокам"
                                    Width="240"
                                    HorizontalAlignment="Left"
                                    Click="SaveClientBlocks_Click" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PrintingCategoryPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Печать"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Настройки устройств для печати производственных этикеток."
                               Margin="0,4,0,12"
                               Foreground="#666666"
                               TextWrapping="Wrap" />

                    <GroupBox Header="Печать паллетных этикеток">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Принтер"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="PalletLabelPrinterComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      MinWidth="280"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="Обновить список"
                                    Width="150"
                                    Margin="12,0,0,0"
                                    Click="RefreshPalletLabelPrinters_Click" />

                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       Text="Оставьте поле пустым, чтобы использовать принтер шаблона BarTender или системный принтер по умолчанию. Можно ввести точное имя вручную."
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="PalletLabelPrinterStatusText"
                                       Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <Button x:Name="SavePalletLabelPrinterButton"
                                    Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Content="Сохранить"
                                    Width="140"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SavePalletLabelPrinter_Click" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MaintenanceCategoryPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,12">
                    <TextBlock Text="Обслуживание"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Диагностические и служебные операции вынесены в отдельное окно обслуживания."
                               Margin="0,4,0,12"
                               Foreground="#666666"
                               TextWrapping="Wrap" />

                    <GroupBox Header="Обслуживание">
                        <StackPanel Margin="8">
                            <TextBlock Text="Откройте окно обслуживания для доступных диагностических и административных операций."
                                       TextWrapping="Wrap" />
                            <Button Content="Открыть обслуживание..."
                                    Width="190"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OpenMaintenance_Click" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                Padding="0,10,0,0"
                BorderBrush="#D8DDE3"
                BorderThickness="0,1,0,0">
            <Button Content="Закрыть"
                    Width="120"
                    HorizontalAlignment="Right"
                    IsCancel="True" />
        </Border>
    </Grid>
</Window>
